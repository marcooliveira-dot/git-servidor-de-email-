{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:GetBucketVersioning", "s3:ListBucket"],
      "Resource": ["arn:aws:s3:::ALTERAR-arquivo", "arn:aws:s3:::ALTERAR-backup"]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:GetObjectVersion"],
      "Resource": ["arn:aws:s3:::ALTERAR-arquivo/*", "arn:aws:s3:::ALTERAR-backup/*"]
    }
  ]
}
