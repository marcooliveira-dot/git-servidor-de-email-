[Unit]
Description=Painel administrativo de arquivo de e-mails
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=email-archive
Group=email-archive
WorkingDirectory=/opt/email-archive/app
EnvironmentFile=/etc/email-archive/archive.env
ExecStart=/opt/email-archive/app/.venv/bin/uvicorn email_archive.web:create_app --factory --host 127.0.0.1 --port 8000 --no-proxy-headers
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/email-archive

[Install]
WantedBy=multi-user.target
